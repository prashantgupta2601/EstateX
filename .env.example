# Database Connection (Neon PostgreSQL)
DATABASE_URL="postgresql://username:password@ep-example-pooler.region.aws.neon.tech/estatehub?sslmode=require"
DIRECT_URL="postgresql://username:password@ep-example.region.aws.neon.tech/estatehub?sslmode=require"

# NextAuth Authentication Configuration
NEXTAUTH_SECRET="your-nextauth-secret-key-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Gemini API (for AI property description generator)
# Get free API key from https://aistudio.google.com/app/apikey (Free tier: 1500 requests/day gemini-1.5-flash model)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary (for property image/video uploads)
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Razorpay Configuration (Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
